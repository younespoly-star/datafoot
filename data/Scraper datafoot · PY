import json
import os

# Fichier brut et fichier final
raw_file = "matchs_datafoot.json"
output_file = "matches.json"

try:
    if os.path.exists(raw_file):
        with open(raw_file, 'r', encoding='utf-8') as f:
            raw_data = json.load(f)
    else:
        raw_data = []

    matches_list = []
    for item in raw_data:
        # Nettoyage des données pour éviter les valeurs nulles ou bloquantes
        domicile = item.get("domicile") or item.get("homeTeam") or "Inconnu"
        exterieur = item.get("exterieur") or item.get("awayTeam") or "Inconnu"
        competition = item.get("competition", "Football")
        
        # Correction si la compétition est mal étiquetée uniformément
        if competition == "Leagues Cup" and "FC" not in domicile:
            competition = "Match Amical / Autre"

        match_clean = {
            "competition": competition,
            "homeTeam": domicile,
            "awayTeam": exterieur,
            "score": item.get("score", "0 - 0"),
            "statut": item.get("statut", "Scheduled"),
            "pick": item.get("pick") or "1X",  # Valeur par défaut pour éviter le vide
            "odds": item.get("odds") or 1.75,
            "confidence": item.get("confidence", 3)
        }
        matches_list.append(match_clean)

    # Structure finale attendue par le front-end
    final_output = {
        "generatedAt": os.popen('date -u +"%Y-%m-%dT%H:%M:%SZ"').read().strip(),
        "count": len(matches_list),
        "matches": matches_list
    }

    # Sauvegarde dans data/matches.json ou à la racine selon votre structure
    os.makedirs("data", exist_ok=True)
    with open("data/matches.json", "w", encoding='utf-8') as f:
        json.dump(final_output, f, ensure_ascii=False, indent=4)
        
    print("Mise à jour de matches.json réussie avec succès !")

except Exception as e:
    print(f"Erreur lors du traitement : {e}")
