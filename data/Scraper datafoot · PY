"""
scraper_datafoot.py
--------------------
Combine deux sources :
1. ESPN (scoreboard) -> liste des matchs a venir (equipes, competition, date)
2. The Odds API       -> vraies cotes du marche (1X2) pour ces memes matchs

Resultat : data/matches.json, au format attendu par render-matches.js
et render-coupons.js (homeTeam, awayTeam, date, pick, odds, confidence,
competition).

Avant de lancer le script :
1. Cree un compte gratuit sur https://the-odds-api.com/ (quota gratuit
   suffisant pour un usage quotidien perso).
2. Colle ta cle API ci-dessous, a la place de "TA_CLE_ICI".
3. Assure-toi que le dossier "data/" existe a la racine de ton depot
   (cree-le s'il n'existe pas), c'est la que le fichier sera ecrit.
"""

import difflib
import json
import os
import unicodedata
import requests

# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------

ODDS_API_KEY = os.environ.get("ODDS_API_KEY", "e8776e10ba3aa7c2f4389b0adc32a6de")

# Championnats couverts cote ESPN (slug -> nom affiche)
DICO_LIGUES = {
    "leagues.cup": "Leagues Cup",
    "usa.1": "MLS",
    "mex.1": "Liga MX",
    "fra.1": "Ligue 1",
    "fra.2": "Ligue 2",
    "eng.1": "Premier League",
    "esp.1": "La Liga",
    "ger.1": "Bundesliga",
    "ita.1": "Serie A",
    "uefa.champions": "Ligue des Champions",
    "uefa.europa": "Europa League",
}

# Championnats couverts cote The Odds API (cle technique de l'API)
ODDS_API_SPORTS = [
    "soccer_epl",
    "soccer_spain_la_liga",
    "soccer_germany_bundesliga",
    "soccer_italy_serie_a",
    "soccer_france_ligue_one",
    "soccer_uefa_champs_league",
    "soccer_uefa_europa_league",
    "soccer_usa_mls",
]

OUTPUT_PATH = os.path.join("data", "matches.json")


# ----------------------------------------------------------------------
# Utilitaires
# ----------------------------------------------------------------------

def normaliser(nom):
    """Nettoie un nom d'equipe pour faciliter les comparaisons
    (minuscules, sans accents, sans espaces superflus)."""
    if not nom:
        return ""
    nom = unicodedata.normalize("NFKD", nom).encode("ascii", "ignore").decode()
    return nom.lower().strip()


def equipes_correspondent(nom_a, nom_b, seuil=0.72):
    """Renvoie True si deux noms d'equipe designent probablement la
    meme equipe (les sources ESPN et Odds API n'orthographient pas
    toujours les clubs de la meme facon)."""
    a, b = normaliser(nom_a), normaliser(nom_b)
    if not a or not b:
        return False
    if a == b or a in b or b in a:
        return True
    ratio = difflib.SequenceMatcher(None, a, b).ratio()
    return ratio >= seuil


def extraire_competition(event, comp_data):
    for obj in [comp_data.get("league"), event.get("league")]:
        if isinstance(obj, dict):
            nom = obj.get("name") or obj.get("midsizeName")
            if nom and nom.lower() not in ["league phase", "group stage", "scheduled", "football", "match"]:
                return nom
            slug = obj.get("slug")
            if slug in DICO_LIGUES:
                return DICO_LIGUES[slug]
    season_slug = event.get("season", {}).get("slug", "")
    if season_slug in DICO_LIGUES:
        return DICO_LIGUES[season_slug]
    return "Football"


# ----------------------------------------------------------------------
# 1. Matchs a venir (ESPN)
# ----------------------------------------------------------------------

def obtenir_matchs_espn():
    print("Recuperation des matchs a venir (ESPN)...")
    url = "https://site.api.espn.com/apis/site/v2/sports/soccer/all/scoreboard"

    try:
        response = requests.get(url, timeout=10)
        data = response.json()
    except Exception as e:
        print(f"Erreur ESPN : {e}")
        return []

    matchs = []
    for event in data.get("events", []):
        statut = event.get("status", {}).get("type", {}).get("state")
        if statut != "pre":
            # On ne garde que les matchs pas encore commences :
            # un pronostic n'a de sens que pour un match a venir.
            continue

        comp_data = event.get("competitions", [{}])[0]
        competitors = comp_data.get("competitors", [])
        domicile = next((c for c in competitors if c.get("homeAway") == "home"), None)
        exterieur = next((c for c in competitors if c.get("homeAway") == "away"), None)
        if not (domicile and exterieur):
            continue

        matchs.append({
            "competition": extraire_competition(event, comp_data),
            "homeTeam": domicile["team"]["displayName"],
            "awayTeam": exterieur["team"]["displayName"],
            "date": event.get("date"),
        })

    print(f"{len(matchs)} matchs a venir trouves.")
    return matchs


# ----------------------------------------------------------------------
# 2. Cotes reelles (The Odds API)
# ----------------------------------------------------------------------

def obtenir_cotes():
    if ODDS_API_KEY == "TA_CLE_ICI":
        print("Aucune cle The Odds API renseignee : les matchs seront "
              "publies sans pick ni cote (voir haut du fichier).")
        return []

    print("Recuperation des cotes (The Odds API)...")
    toutes_les_cotes = []

    for sport in ODDS_API_SPORTS:
        url = f"https://api.the-odds-api.com/v4/sports/{sport}/odds"
        params = {
            "apiKey": ODDS_API_KEY,
            "regions": "eu",
            "markets": "h2h",
            "oddsFormat": "decimal",
        }
        try:
            res = requests.get(url, params=params, timeout=10)
            if res.status_code != 200:
                continue
            toutes_les_cotes.extend(res.json())
        except Exception as e:
            print(f"Erreur The Odds API ({sport}) : {e}")

    print(f"{len(toutes_les_cotes)} matchs avec cotes recuperes.")
    return toutes_les_cotes


def moyenne_cotes_h2h(event_odds):
    """Fait la moyenne des cotes 1X2 proposees par les differents
    bookmakers pour un match donne."""
    home, draw, away = [], [], []
    home_name = event_odds.get("home_team")
    away_name = event_odds.get("away_team")

    for bookmaker in event_odds.get("bookmakers", []):
        for market in bookmaker.get("markets", []):
            if market.get("key") != "h2h":
                continue
            for outcome in market.get("outcomes", []):
                nom, prix = outcome.get("name"), outcome.get("price")
                if nom == home_name:
                    home.append(prix)
                elif nom == away_name:
                    away.append(prix)
                else:
                    draw.append(prix)

    def moy(liste):
        return sum(liste) / len(liste) if liste else None

    return moy(home), moy(draw), moy(away)


# ----------------------------------------------------------------------
# 3. Construction du pronostic a partir des cotes
# ----------------------------------------------------------------------

def confiance_depuis_cote(cote):
    if cote is None:
        return 0
    if cote <= 1.30:
        return 5
    if cote <= 1.50:
        return 4
    if cote <= 1.80:
        return 3
    if cote <= 2.20:
        return 2
    return 1


def construire_pronostic(home_team, away_team, cote_home, cote_draw, cote_away):
    """Choisit un pick a partir des vraies cotes du marche :
    - si un camp est nettement favori (cote basse), on le joue sec
    - sinon on propose une double chance, plus prudente."""
    if cote_home is None or cote_away is None:
        return None, None, 0

    if cote_home <= cote_away:
        favori, cote_favori, autre_cote = home_team, cote_home, cote_draw
        libelle_sec = f"Victoire {home_team}"
        libelle_double = f"Double Chance : {home_team} ou match nul"
    else:
        favori, cote_favori, autre_cote = away_team, cote_away, cote_draw
        libelle_sec = f"Victoire {away_team}"
        libelle_double = f"Double Chance : {away_team} ou match nul"

    if cote_favori <= 1.60:
        pick = libelle_sec
        cote_pick = cote_favori
    else:
        pick = libelle_double
        if cote_favori and autre_cote:
            cote_pick = round(1 / (1 / cote_favori + 1 / autre_cote), 2)
        else:
            cote_pick = cote_favori

    return pick, cote_pick, confiance_depuis_cote(cote_pick)


# ----------------------------------------------------------------------
# 4. Assemblage final
# ----------------------------------------------------------------------

def assembler(matchs_espn, cotes_api):
    resultat = []

    for m in matchs_espn:
        pick, cote_pick, confiance = None, None, 0

        for event_odds in cotes_api:
            if equipes_correspondent(m["homeTeam"], event_odds.get("home_team")) and \
               equipes_correspondent(m["awayTeam"], event_odds.get("away_team")):
                cote_home, cote_draw, cote_away = moyenne_cotes_h2h(event_odds)
                pick, cote_pick, confiance = construire_pronostic(
                    m["homeTeam"], m["awayTeam"], cote_home, cote_draw, cote_away
                )
                break

        resultat.append({
            "competition": m["competition"],
            "homeTeam": m["homeTeam"],
            "awayTeam": m["awayTeam"],
            "date": m["date"],
            "pick": pick,          # None si aucune cote trouvee -> "Pronostic a venir" cote site
            "odds": cote_pick,     # None si aucune cote trouvee -> "-" cote site
            "confidence": confiance,
        })

    return resultat


def main():
    matchs_espn = obtenir_matchs_espn()
    cotes_api = obtenir_cotes()
    matches = assembler(matchs_espn, cotes_api)

    os.makedirs(os.path.dirname(OUTPUT_PATH), exist_ok=True)
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump({"matches": matches}, f, ensure_ascii=False, indent=2)

    avec_pick = sum(1 for m in matches if m["pick"])
    print(f"Termine : {len(matches)} matchs ecrits dans {OUTPUT_PATH} "
          f"({avec_pick} avec un vrai pronostic base sur des cotes reelles).")


if __name__ == "__main__":
    main()
